{
  // Global tuning. Distances are in art pixels (one tile = 16), times in ticks (60 per second),
  // health and damage in half hearts.
  "title": "Hollow Crypt",
  "saveSlots": 4,
  "world": { "width": 256, "height": 192, "seed": 1337 },
  "player": {
    "speed": 1.3,
    "rollTicks": 16,
    "rollCooldown": 40,
    "attackTicks": 14,
    "inputBuffer": 10,
    "baseHp": 10,
    "invSlots": 30,
    "hitInvulnTicks": 50,
    "recallTicks": 210,
    "mountCastTicks": 45,
    "combatLockTicks": 240
  },
  "fists": { "dmg": 1, "reach": 9, "cd": 18 },
  "leveling": {
    // Levels run to 99, the way WoW paces them: a monster of your level gives 45 + 5 * level experience, and a
    // level costs that many times (xpKillsBase + xpKillsPerLevel * level) kills, multiplied past "xpLateFrom" by
    // 1 + (level - xpLateFrom)^2 / xpLateDiv. About 10 kills for level 2, 60 at level 50, several hundred near 99.
    // Monsters far beneath you turn grey and give nothing; those above give a bonus (sim_enemies.cpp).
    "maxLevel": 99,
    "xpBase": 1,
    "xpGrowth": 1,
    "xpKillsBase": 9,
    "xpKillsPerLevel": 1.0,
    "xpLateFrom": 55,
    "xpLateDiv": 220,
    // Levels no longer give hearts: every "skillPointEvery" levels give a point to spend in the skill tree (skills.json).
    // Max health grows with the Vitality skills, armour and helms, and Heart Crystals forged from the
    // shards bosses drop ("heartShardsPerHeart" shards make one crystal).
    // Armour ("ward") can never block more than half of a hit.
    "heartEveryLevels": 0,
    "skillPointEvery": 2,
    "heartShardsPerHeart": 4,
    "damageEveryLevels": 12,
    "discoverZoneXp": 4
  },
  "skills": {
    // Whirlwind is learned in the skill tree; these are its base numbers.
    "whirlwind": { "cooldown": 360, "radius": 30, "damageMul": 1.5 }
  },
  "day": { "lengthTicks": 28800, "startHour": 8 },
  "spawns": {
    "activeRadius": 30,
    "despawnRadius": 46,
    "respawnTicks": 7200,
    "eliteChance": 0.06,
    "globeChance": 0.12
  },
  "shrines": { "buffTicks": 3600, "rechargeTicks": 18000 },
  "trees": { "chops": 3, "stumpTicks": 3000, "saplingTicks": 2400 },
  "death": { "goldLostFraction": 0.25 },
  // Resting or sleeping at a fire is refused during a fight or with a hostile monster this close (pixels).
  "rest": { "enemyRadius": 160 },
  "autosaveTicks": 1800
}
