  // role: quest | merchant | stable | smith | herbalist. "shop" names an entry in "shops" below.
  // "sprite" is a fortress-kit character (ch1..ch9), "tint" recolours it.
  "towns": [
    { "id": "greenhollow", "name": "Greenhollow", "at": [44, 152], "radius": 13, "houses": 4, "stalls": 1, "zone": "vale", "music": "town_a",
      "features": ["campfire", "waypoint", "fence", "start"],
      "npcs": [
        { "id": "warden", "name": "Warden Aldric", "sprite": "ch6", "role": "quest",
          "text": "Welcome to Greenhollow. Chop trees, mine rocks and pick herbs with the Use key, then open Crafting. The fire roasts meat and forges iron, and resting there heals you. The world is wide: follow the roads, and read the signposts." },
        { "id": "mira", "name": "Huntress Mira", "sprite": "ch7", "role": "quest",
          "text": "The vale feeds us, if you know how to hunt it. Boars charge, so step aside. Foxes do not give up." },
        { "id": "merchant", "name": "Tobin the Trader", "sprite": "ch2", "role": "merchant", "shop": "general", "text": "" },
        { "id": "hobb", "name": "Stablemaster Hobb", "sprite": "ch2", "tint": "#c8a878", "role": "stable", "shop": "stable", "text": "" }
      ] },
    { "id": "thornwick", "name": "Thornwick", "at": [52, 62], "radius": 11, "houses": 3, "stalls": 1, "zone": "deepwood", "music": "town_b",
      "features": ["fountain", "campfire", "waypoint", "fence"],
      "npcs": [
        { "id": "rowan", "name": "Elder Rowan", "sprite": "ch6", "tint": "#a8c890", "role": "quest",
          "text": "Thornwick has stood under these boughs for three hundred years. Lately the wood itself has turned on us." },
        { "id": "sela", "name": "Sela the Herbalist", "sprite": "ch7", "tint": "#c8e0a0", "role": "herbalist", "shop": "herbalist",
          "text": "" },
        { "id": "scout", "name": "Scout Edda", "sprite": "ch7", "tint": "#e0c8a0", "role": "quest",
          "text": "I keep watch on the old road. Fewer travellers every season, and more things that bite." }
      ] },
    { "id": "crossroads", "name": "Wayfarers' Rest", "at": [118, 112], "radius": 9, "houses": 2, "stalls": 1, "zone": "heartlands", "music": "town_c",
      "features": ["campfire", "waypoint"],
      "npcs": [
        { "id": "oswin", "name": "Pilgrim Oswin", "sprite": "ch6", "tint": "#d8d0f0", "role": "quest",
          "text": "Every road in the realm crosses here. I walk them all, from shrine to shrine. The old stones still answer, if you touch them." },
        { "id": "peddler", "name": "Road Peddler", "sprite": "ch2", "tint": "#e0b0a0", "role": "merchant", "shop": "general", "text": "" }
      ] },
    { "id": "saltmere", "name": "Saltmere", "at": [160, 168], "radius": 13, "houses": 5, "stalls": 2, "zone": "coast", "music": "town_harbor",
      "features": ["fountain", "campfire", "forge", "waypoint", "fence"],
      "npcs": [
        { "id": "brine", "name": "Captain Brine", "sprite": "ch1", "tint": "#a0c0e0", "role": "quest",
          "text": "Saltmere lives by its harbour, and the harbour is being bled dry. Smugglers, lad. A whole nest of them down the coast." },
        { "id": "dagna", "name": "Dagna the Smith", "sprite": "ch7", "tint": "#e0a080", "role": "smith", "shop": "smith",
          "text": "" },
        { "id": "fishmonger", "name": "Old Fishmonger", "sprite": "ch2", "tint": "#b0d0d0", "role": "merchant", "shop": "general", "text": "" }
      ] },
    { "id": "fenwatch", "name": "Fenwatch", "at": [200, 108], "radius": 8, "houses": 1, "stalls": 0, "zone": "marsh", "music": "town_c",
      "features": ["campfire", "waypoint", "fence"],
      "npcs": [
        { "id": "voss", "name": "Quartermaster Voss", "sprite": "ch1", "tint": "#b0c0a0", "role": "quest",
          "text": "This is the last dry ground before the Ashen Marsh. Mind the reeds. What hunts there, hunts quietly." },
        { "id": "sutler", "name": "Camp Sutler", "sprite": "ch2", "tint": "#a0b090", "role": "merchant", "shop": "general", "text": "" }
      ] },
    { "id": "highwatch", "name": "Highwatch", "at": [128, 34], "radius": 12, "houses": 4, "stalls": 1, "zone": "frost", "music": "town_b",
      "features": ["fountain", "campfire", "forge", "waypoint", "towers"],
      "npcs": [
        { "id": "yrsa", "name": "Commander Yrsa", "sprite": "ch1", "tint": "#d0e0ff", "role": "quest",
          "text": "Highwatch guards the pass. Beyond it, in the eastern peaks, the Hollow King sits on his throne of bones. No one I have sent has come back." },
