{
  // giver / turnIn are NPC ids from world.json (turnIn defaults to the giver).
  // objective types:
  //   have    - own "item" x count (not taken from you)
  //   collect - hand over "item" x count
  //   kill    - defeat count monsters whose id or tag is "target"
  //   boss    - defeat the boss of dungeon "target"
  //   visit   - walk into the town "target"
  //   talk    - speak to the NPC "target"
  //   shrine  - awaken count wayside shrines
  // rewards: xp, gold, items [[id, quantity]]. "requires" lists quests that must be finished first.
  "quests": [
    { "id": "first_blade", "title": "A Blade of Your Own", "giver": "warden", "main": true,
      "offer": "You will not last a night out there with bare fists. Chop some trees and craft yourself a wooden sword, or find something better.",
      "progress": "Four pieces of wood will do. Chop trees, then open Crafting.",
      "done": "That will keep the foxes off you. Here, for the scrapes.",
      "objectives": [{ "type": "have", "item": "wood_sword", "count": 1, "label": "Craft a Wooden Sword", "anyWeapon": true }],
      "rewards": { "xp": 20, "items": [["bandage", 2]] } },
    { "id": "camp_stew", "title": "Camp Stew", "giver": "warden", "requires": ["first_blade"],
      "offer": "The village is hungry. Bring me 5 Raw Meat and I will pay you for it.",
      "progress": "Boars, hares and deer roam the fields around the vale.",
      "done": "That will feed everyone! Take some roast meat and a little coin.",
      "objectives": [{ "type": "collect", "item": "meat", "count": 5, "label": "Raw Meat" }],
      "rewards": { "xp": 40, "gold": 10, "items": [["roast", 2]] } },
    { "id": "cellar_trouble", "title": "Trouble in the Cellar", "giver": "warden", "requires": ["first_blade"], "main": true,
      "offer": "Bandits have dug into the old cellar east of here, past the bridge. Their chief, Gruff, has been robbing the road. Put an end to it.",
      "progress": "The cellar entrance is east along the road. Bring bandages.",
      "done": "Gruff is gone? Then the road is open again. You have earned this.",
      "objectives": [{ "type": "boss", "target": "cellar", "count": 1, "label": "Defeat Gruff in the Old Cellar" }],
      "rewards": { "xp": 90, "gold": 20, "items": [["iron_sword", 1]] } },
    { "id": "thin_herd", "title": "Thin the Herd", "giver": "mira",
      "offer": "The boars are rooting up every field we plant. Bring down 6 of them.",
      "progress": "Watch for the red mark over their heads, then step aside.",
      "done": "Clean work. The farmers will sleep easier.",
      "objectives": [{ "type": "kill", "target": "boar", "count": 6, "label": "Boars hunted" }],
      "rewards": { "xp": 45, "gold": 8, "items": [["arrows", 10]] } },
    { "id": "fox_trouble", "title": "Night Prowlers", "giver": "mira", "requires": ["thin_herd"],
      "offer": "Foxes come out of the woods at nightfall and take our hens. Hunt 6 of them.",
      "progress": "They are bolder at night. So should you be.",
      "done": "Take this crossbow. You have a hunter's eye.",
      "objectives": [{ "type": "kill", "target": "fox", "count": 6, "label": "Foxes hunted" }],
      "rewards": { "xp": 60, "gold": 10, "items": [["bow", 1], ["arrows", 12]] } },
    { "id": "road_north", "title": "The Road North", "giver": "warden", "requires": ["cellar_trouble"], "turnIn": "rowan", "main": true,
      "offer": "Elder Rowan of Thornwick sent word that Deepwood is stirring. Follow the road north through the forest and offer him your help.",
      "progress": "Thornwick lies north, deep under the trees. Follow the road.",
      "done": "Aldric sent you? Then there is hope yet. Sit, and listen.",
      "objectives": [{ "type": "visit", "target": "thornwick", "count": 1, "label": "Reach Thornwick" }],
      "rewards": { "xp": 70, "gold": 10 } },

    { "id": "whispering_stumps", "title": "Whispering Stumps", "giver": "rowan", "requires": ["road_north"],
      "offer": "The stumps walk. I have seen it. Cut down 8 of the stumplings before they reach our gates.",
      "progress": "They shamble through the woods all around Thornwick.",
      "done": "Their bark is still warm, is it not? Something feeds them.",
      "objectives": [{ "type": "kill", "target": "treant", "count": 8, "label": "Stumplings felled" }],
      "rewards": { "xp": 110, "gold": 15, "items": [["potion", 1]] } },
    { "id": "heart_of_burrow", "title": "Heart of the Burrow", "giver": "rowan", "requires": ["whispering_stumps"], "main": true,
      "offer": "The oldest root in Deepwood has woken, in a burrow far to the north-west. While it lives, the forest will not rest.",
      "progress": "The burrow lies north-west of here, where the wood is thickest.",
      "done": "I felt it fall. The whole forest breathed out. Wear this, and remember us.",
      "objectives": [{ "type": "boss", "target": "burrow", "count": 1, "label": "Defeat the Elder Root" }],
      "rewards": { "xp": 180, "gold": 30, "items": [["band", 1]], "rarity": 2 } },
    { "id": "remedy", "title": "A Bitter Remedy", "giver": "sela",
      "offer": "I am out of everything. Bring me 8 herbs and I will show you what they are really for.",
      "progress": "Red wildflowers. They grow thick in Deepwood.",
      "done": "Watch closely: four herbs and a piece of living bark, over a fire. Now you can brew your own.",
      "objectives": [{ "type": "collect", "item": "herb", "count": 8, "label": "Herbs" }],
      "rewards": { "xp": 70, "items": [["potion", 2]] } },
    { "id": "grouse_hunt", "title": "Grouse Hunt", "giver": "scout",
      "offer": "Black grouse dive at travellers on the high roads. Shoot down 4 of them. You will want a crossbow.",
      "progress": "They nest where the ground turns to rock.",
      "done": "The road is safer for it. Take these bolts.",
      "objectives": [{ "type": "kill", "target": "grouse", "count": 4, "label": "Grouse downed" }],
      "rewards": { "xp": 80, "gold": 8, "items": [["arrows", 15]] } },

    { "id": "lost_shrines", "title": "The Old Stones", "giver": "oswin",
      "offer": "Wayside shrines stand all over the realm, half buried. Wake 3 of them with your hand and tell me what you felt.",
      "progress": "Look for carved stone plates in the wild. They glow when you draw near.",
      "done": "Strength, swiftness, fortune. The old stones give what the road asks. Walk well.",
      "objectives": [{ "type": "shrine", "count": 3, "label": "Shrines awakened" }],
      "rewards": { "xp": 120, "gold": 25 } },
    { "id": "to_the_coast", "title": "Salt on the Wind", "giver": "oswin", "turnIn": "brine",
      "offer": "Captain Brine of Saltmere is asking for anyone who can hold a sword. Take the south-east road to the coast.",
      "progress": "Saltmere is south-east, where the road meets the sea.",
      "done": "A fighter, at last. Sit down, I will tell you what we are up against.",
      "objectives": [{ "type": "visit", "target": "saltmere", "count": 1, "label": "Reach Saltmere" }],
      "rewards": { "xp": 90, "gold": 15 } },

    { "id": "good_iron", "title": "Good Iron", "giver": "dagna",
      "offer": "I cannot forge without ore. Bring me 6 Iron Ore. You will need a pickaxe.",
      "progress": "Rusty crystal rocks, along the cliffs.",
      "done": "Now that is ore. Take this, it is the least I can do.",
      "objectives": [{ "type": "collect", "item": "iron", "count": 6, "label": "Iron Ore" }],
      "rewards": { "xp": 110, "gold": 20, "items": [["iron_shield", 1]] } },
    { "id": "smugglers_cove", "title": "Smugglers' Cove", "giver": "brine", "requires": ["to_the_coast"], "main": true,
      "offer": "The smugglers answer to a man called Marrow. He holds a cove at the far east end of the coast. End him and Saltmere breathes again.",
      "progress": "East along the shore, as far as the land goes.",
      "done": "Marrow is dead? Then drink with us tonight. And take this: you will want it where you are going.",
      "objectives": [{ "type": "boss", "target": "cove", "count": 1, "label": "Defeat Captain Marrow" }],
      "rewards": { "xp": 260, "gold": 50, "items": [["chain_armor", 1]], "rarity": 1 } },
    { "id": "supply_run", "title": "Supply Run", "giver": "brine", "requires": ["to_the_coast"], "turnIn": "voss",
      "offer": "Fenwatch, the outpost at the edge of the marsh, has had no word from us in weeks. Carry my report to Quartermaster Voss, north-east of here.",
      "progress": "Fenwatch is north-east, on the last dry ground before the marsh.",
      "done": "From Brine? About time. You look like you can handle yourself.",
      "objectives": [{ "type": "visit", "target": "fenwatch", "count": 1, "label": "Reach Fenwatch" }],
      "rewards": { "xp": 120, "gold": 20 } },

    { "id": "stalkers", "title": "Stalkers in the Reeds", "giver": "voss",
      "offer": "Marsh stalkers have taken three of my sentries. Kill 8 of the things.",
      "progress": "They wait in the reeds east of camp.",
      "done": "Eight fewer. My sentries thank you, the ones I have left.",
      "objectives": [{ "type": "kill", "target": "stalker", "count": 8, "label": "Marsh stalkers slain" }],
      "rewards": { "xp": 240, "gold": 30, "items": [["potion", 2]] } },
    { "id": "drowned_vaults", "title": "The Drowned Vaults", "giver": "voss", "requires": ["stalkers"], "main": true,
      "offer": "There is an old vault sinking into the marsh, far to the east. Its dead do not stay down, and something down there commands them.",
      "progress": "East, beyond the worst of the marsh. Look for a stone door.",
      "done": "The Warden is gone. Maybe now the marsh will keep its dead.",
      "objectives": [{ "type": "boss", "target": "sunken", "count": 1, "label": "Defeat the Bog Warden" }],
      "rewards": { "xp": 380, "gold": 70, "items": [["signet", 1]], "rarity": 2 } },
    { "id": "to_highwatch", "title": "The High Pass", "giver": "voss", "requires": ["stalkers"], "turnIn": "yrsa", "main": true,
      "offer": "Commander Yrsa holds Highwatch, in the mountains to the north-west. If anyone means to face the Hollow King, it starts there.",
      "progress": "Highwatch is north-west, where the snow begins.",
      "done": "Voss vouches for you. That is enough for me.",
      "objectives": [{ "type": "visit", "target": "highwatch", "count": 1, "label": "Reach Highwatch" }],
      "rewards": { "xp": 200, "gold": 25 } },

    { "id": "wolves_gate", "title": "Wolves at the Gate", "giver": "yrsa", "requires": ["to_highwatch"],
      "offer": "Frost wolves circle the walls every night. Kill 8 and the pack will think twice.",
      "progress": "They run in the snow all around Highwatch.",
      "done": "The howling has stopped. Good.",
      "objectives": [{ "type": "kill", "target": "wolf", "count": 8, "label": "Wolves slain" }],
      "rewards": { "xp": 320, "gold": 40, "items": [["potion", 2]] } },
    { "id": "deep_mine", "title": "What the Miners Woke", "giver": "yrsa", "requires": ["to_highwatch"],
      "offer": "Our miners dug too deep in the western mine and something of ice and stone dug back. Destroy it.",
      "progress": "The mine is west along the mountain road.",
      "done": "Rimeheart, they called it. You have my thanks, and the armoury's.",
      "objectives": [{ "type": "boss", "target": "mine", "count": 1, "label": "Defeat Rimeheart" }],
      "rewards": { "xp": 480, "gold": 90, "items": [["plate_armor", 1]], "rarity": 1 } },
    { "id": "hollow_king", "title": "The Hollow King", "giver": "yrsa", "requires": ["wolves_gate"], "main": true,
      "offer": "East, at the end of the mountain road, a stone door leads into the Hollow Crypt. The King's gate is sealed, and its key is kept in the east wing. Go, and come back alive.",
      "progress": "The crypt is far to the east. Find the key in the east wing, open the gate, and end him.",
      "done": "It is done, then. The crown is yours to keep. The realm will remember your name.",
      "objectives": [{ "type": "boss", "target": "crypt", "count": 1, "label": "Defeat the Hollow King" }],
      "rewards": { "xp": 900, "gold": 200 } }
  ]
}
