{
  // giver / turnIn are NPC ids from world.json (turnIn defaults to the giver).
  // objective types:
  //   have    - own "item" x count (not taken from you)
  //   collect - hand over "item" x count
  //   kill    - defeat count monsters whose id or tag is "target"
  //   boss    - defeat the boss of dungeon "target"
  //   visit   - walk into the town "target"
  //   talk    - speak to the NPC "target"
  //   shrine  - awaken count wayside shrines
  // rewards: xp, gold, items [[id, quantity]] (always given), choice [[id, quantity]] (the hero picks one).
  // "requires" lists quests that must be finished first. "summary": the one-line goal in the quest window.
  // "level": recommended level (default: the lowest level of the giver's region).
  "quests": [
    { "id": "first_blade", "title": "A Blade of Your Own", "giver": "warden", "main": true,
      "offer": "You will not last a night out there with bare fists. Chop some trees and craft yourself a wooden sword, or find something better.",
      "progress": "Four pieces of wood will do. Chop trees, then open Crafting.",
      "done": "That will keep the foxes off you. Here, for the scrapes.",
      "objectives": [{ "type": "have", "item": "wood_sword", "count": 1, "label": "Craft a Wooden Sword", "anyWeapon": true }],
      "rewards": { "xp": 20, "items": [["bandage", 2]] } },
    { "id": "camp_stew", "title": "Camp Stew", "giver": "warden", "requires": ["first_blade"],
      "offer": "The village is hungry. Bring me 5 Raw Meat and I will pay you for it.",
      "progress": "Boars, hares and deer roam the fields around the vale.",
      "done": "That will feed everyone! Take some roast meat and a little coin.",
      "objectives": [{ "type": "collect", "item": "meat", "count": 5, "label": "Raw Meat" }],
      "rewards": { "xp": 40, "gold": 10, "items": [["roast", 2]] } },
    { "id": "cellar_trouble", "title": "Trouble in the Cellar", "giver": "warden", "requires": ["first_blade"], "main": true,
      "offer": "Bandits have dug into the old cellar east of here, past the bridge. Their chief, Gruff, has been robbing the road. Put an end to it.",
      "progress": "The cellar entrance is east along the road. Bring bandages.",
      "done": "Gruff is gone? Then the road is open again. You have earned this.",
      "objectives": [{ "type": "boss", "target": "cellar", "count": 1, "label": "Defeat Gruff in the Old Cellar" }],
      "rewards": { "xp": 90, "gold": 20, "items": [["iron_sword", 1]] } },
    { "id": "thin_herd", "title": "Thin the Herd", "giver": "mira",
      "offer": "The boars are rooting up every field we plant. Bring down 6 of them.",
      "progress": "Watch for the red mark over their heads, then step aside.",
      "done": "Clean work. The farmers will sleep easier.",
      "objectives": [{ "type": "kill", "target": "boar", "count": 6, "label": "Boars hunted" }],
      "rewards": { "xp": 45, "gold": 8, "items": [["arrows", 10]] } },
    { "id": "fox_trouble", "title": "Night Prowlers", "giver": "mira", "requires": ["thin_herd"],
      "offer": "Foxes come out of the woods at nightfall and take our hens. Hunt 6 of them.",
      "progress": "They are bolder at night. So should you be.",
      "done": "Take this crossbow. You have a hunter's eye.",
      "objectives": [{ "type": "kill", "target": "fox", "count": 6, "label": "Foxes hunted" }],
      "rewards": { "xp": 60, "gold": 10, "items": [["bow", 1], ["arrows", 12]] } },
    { "id": "road_north", "title": "The Road North", "giver": "warden", "requires": ["cellar_trouble"], "turnIn": "rowan", "main": true,
      "offer": "Elder Rowan of Thornwick sent word that Deepwood is stirring. Follow the road north through the forest and offer him your help.",
      "progress": "Thornwick lies north, deep under the trees. Follow the road.",
      "done": "Aldric sent you? Then there is hope yet. Sit, and listen.",
      "objectives": [{ "type": "visit", "target": "thornwick", "count": 1, "label": "Reach Thornwick" }],
      "rewards": { "xp": 70, "gold": 10 } },

    { "id": "whispering_stumps", "title": "Whispering Stumps", "giver": "rowan", "requires": ["road_north"],
      "offer": "The stumps walk. I have seen it. Cut down 8 of the stumplings before they reach our gates.",
      "progress": "They shamble through the woods all around Thornwick.",
      "done": "Their bark is still warm, is it not? Something feeds them.",
      "objectives": [{ "type": "kill", "target": "treant", "count": 8, "label": "Stumplings felled" }],
      "rewards": { "xp": 110, "gold": 15, "items": [["potion", 1]] } },
    { "id": "heart_of_burrow", "title": "Heart of the Burrow", "giver": "rowan", "requires": ["whispering_stumps"], "main": true,
      "offer": "The oldest root in Deepwood has woken, in a burrow far to the north-west. While it lives, the forest will not rest.",
      "progress": "The burrow lies north-west of here, where the wood is thickest.",
      "done": "I felt it fall. The whole forest breathed out. Wear this, and remember us.",
      "objectives": [{ "type": "boss", "target": "burrow", "count": 1, "label": "Defeat the Elder Root" }],
      "rewards": { "xp": 180, "gold": 30, "items": [["band", 1]], "rarity": 2 } },
    { "id": "remedy", "title": "A Bitter Remedy", "giver": "sela",
      "offer": "I am out of everything. Bring me 8 herbs and I will show you what they are really for.",
      "progress": "Red wildflowers. They grow thick in Deepwood.",
      "done": "Watch closely: four herbs and a piece of living bark, over a fire. Now you can brew your own.",
      "objectives": [{ "type": "collect", "item": "herb", "count": 8, "label": "Herbs" }],
      "rewards": { "xp": 70, "items": [["potion", 2]] } },
    { "id": "grouse_hunt", "title": "Grouse Hunt", "giver": "scout",
      "offer": "Black grouse dive at travellers on the high roads. Shoot down 4 of them. You will want a crossbow.",
      "progress": "They nest where the ground turns to rock.",
      "done": "The road is safer for it. Take these bolts.",
      "objectives": [{ "type": "kill", "target": "grouse", "count": 4, "label": "Grouse downed" }],
      "rewards": { "xp": 80, "gold": 8, "items": [["arrows", 15]] } },

    { "id": "lost_shrines", "title": "The Old Stones", "giver": "oswin",
      "offer": "Wayside shrines stand all over the realm, half buried. Wake 3 of them with your hand and tell me what you felt.",
      "progress": "Look for carved stone plates in the wild. They glow when you draw near.",
      "done": "Strength, swiftness, fortune. The old stones give what the road asks. Walk well.",
      "objectives": [{ "type": "shrine", "count": 3, "label": "Shrines awakened" }],
      "rewards": { "xp": 120, "gold": 25 } },
    { "id": "to_the_coast", "title": "Salt on the Wind", "giver": "oswin", "turnIn": "brine",
      "offer": "Captain Brine of Saltmere is asking for anyone who can hold a sword. Take the south-east road to the coast.",
      "progress": "Saltmere is south-east, where the road meets the sea.",
      "done": "A fighter, at last. Sit down, I will tell you what we are up against.",
      "objectives": [{ "type": "visit", "target": "saltmere", "count": 1, "label": "Reach Saltmere" }],
      "rewards": { "xp": 90, "gold": 15 } },

    { "id": "good_iron", "title": "Good Iron", "giver": "dagna",
      "offer": "I cannot forge without ore. Bring me 6 Iron Ore. You will need a pickaxe.",
      "progress": "Rusty crystal rocks, along the cliffs.",
      "done": "Now that is ore. Take this, it is the least I can do.",
      "objectives": [{ "type": "collect", "item": "iron", "count": 6, "label": "Iron Ore" }],
      "rewards": { "xp": 110, "gold": 20, "items": [["iron_shield", 1]] } },
    { "id": "smugglers_cove", "title": "Smugglers' Cove", "giver": "brine", "requires": ["to_the_coast"], "main": true,
      "offer": "The smugglers answer to a man called Marrow. He holds a cove at the far east end of the coast. End him and Saltmere breathes again.",
      "progress": "East along the shore, as far as the land goes.",
      "done": "Marrow is dead? Then drink with us tonight. And take this: you will want it where you are going.",
      "objectives": [{ "type": "boss", "target": "cove", "count": 1, "label": "Defeat Captain Marrow" }],
      "rewards": { "xp": 260, "gold": 50, "items": [["chain_armor", 1]], "rarity": 1 } },
    { "id": "supply_run", "title": "Supply Run", "giver": "brine", "requires": ["to_the_coast"], "turnIn": "voss",
      "offer": "Fenwatch, the outpost at the edge of the marsh, has had no word from us in weeks. Carry my report to Quartermaster Voss, north-east of here.",
      "progress": "Fenwatch is north-east, on the last dry ground before the marsh.",
      "done": "From Brine? About time. You look like you can handle yourself.",
      "objectives": [{ "type": "visit", "target": "fenwatch", "count": 1, "label": "Reach Fenwatch" }],
      "rewards": { "xp": 120, "gold": 20 } },

    { "id": "stalkers", "title": "Stalkers in the Reeds", "giver": "voss",
      "offer": "Marsh stalkers have taken three of my sentries. Kill 8 of the things.",
      "progress": "They wait in the reeds east of camp.",
      "done": "Eight fewer. My sentries thank you, the ones I have left.",
      "objectives": [{ "type": "kill", "target": "stalker", "count": 8, "label": "Marsh stalkers slain" }],
      "rewards": { "xp": 240, "gold": 30, "items": [["potion", 2]] } },
    { "id": "drowned_vaults", "title": "The Drowned Vaults", "giver": "voss", "requires": ["stalkers"], "main": true,
      "offer": "There is an old vault sinking into the marsh, far to the east. Its dead do not stay down, and something down there commands them.",
      "progress": "East, beyond the worst of the marsh. Look for a stone door.",
      "done": "The Warden is gone. Maybe now the marsh will keep its dead.",
      "objectives": [{ "type": "boss", "target": "sunken", "count": 1, "label": "Defeat the Bog Warden" }],
      "rewards": { "xp": 380, "gold": 70, "items": [["signet", 1]], "rarity": 2 } },
    { "id": "to_highwatch", "title": "The High Pass", "giver": "voss", "requires": ["stalkers"], "turnIn": "yrsa", "main": true,
      "offer": "Commander Yrsa holds Highwatch, in the mountains to the north-west. If anyone means to face the Hollow King, it starts there.",
      "progress": "Highwatch is north-west, where the snow begins.",
      "done": "Voss vouches for you. That is enough for me.",
      "objectives": [{ "type": "visit", "target": "highwatch", "count": 1, "label": "Reach Highwatch" }],
      "rewards": { "xp": 200, "gold": 25 } },

    { "id": "wolves_gate", "title": "Wolves at the Gate", "giver": "yrsa", "requires": ["to_highwatch"],
      "offer": "Frost wolves circle the walls every night. Kill 8 and the pack will think twice.",
      "progress": "They run in the snow all around Highwatch.",
      "done": "The howling has stopped. Good.",
      "objectives": [{ "type": "kill", "target": "wolf", "count": 8, "label": "Wolves slain" }],
      "rewards": { "xp": 320, "gold": 40, "items": [["potion", 2]] } },
    { "id": "deep_mine", "title": "What the Miners Woke", "giver": "yrsa", "requires": ["to_highwatch"],
      "offer": "Our miners dug too deep in the western mine and something of ice and stone dug back. Destroy it.",
      "progress": "The mine is west along the mountain road.",
      "done": "Rimeheart, they called it. You have my thanks, and the armoury's.",
      "objectives": [{ "type": "boss", "target": "mine", "count": 1, "label": "Defeat Rimeheart" }],
      "rewards": { "xp": 480, "gold": 90, "items": [["plate_armor", 1]], "rarity": 1 } },
    { "id": "hollow_king", "title": "The Hollow King", "giver": "yrsa", "requires": ["wolves_gate"], "main": true,
      "offer": "East, at the end of the mountain road, a stone door leads into the Hollow Crypt. The King's gate is sealed, and its key is kept in the east wing. Go, and come back alive.",
      "progress": "The crypt is far to the east. Find the key in the east wing, open the gate, and end him.",
      "done": "It is done, then. The crown is yours to keep. The realm will remember your name.",
      "objectives": [{ "type": "boss", "target": "crypt", "count": 1, "label": "Defeat the Hollow King" }],
      "rewards": { "xp": 900, "gold": 200 } },

    // ───────────── Townsfolk: their own worries ─────────────
    { "id": "bess_larder", "title": "An Empty Larder", "giver": "bess",
      "summary": "Bring Innkeeper Bess 5 Raw Meat.",
      "offer": "Travellers are pouring in from the north and every one of them is hungry. The hunters will not go far from the village since the howling started. Bring me meat, and I will see you are paid in coin and a warm meal.",
      "progress": "Boars, deer and hares all give good meat. I need five pieces.",
      "done": "Bless you. That is tonight's stew sorted, and tomorrow's. Here, take this and something for the road.",
      "objectives": [{ "type": "collect", "item": "meat", "count": 5, "label": "Raw Meat" }],
      "rewards": { "xp": 45, "gold": 12, "choice": [["roast", 3], ["bandage", 4]] } },
    { "id": "corwin_dreams", "title": "Dreams of a Crown", "giver": "corwin",
      "summary": "Ask Brother Anselm at the Chapel of the Dawn about Corwin's dreams.",
      "offer": "Every night the same dream: a crown of black iron, floating in the dark, calling my name. The Brother at the chapel knows the old texts. Would you ask him what it means? I am too ashamed to go myself.",
      "progress": "The chapel is on the square. Brother Anselm will be there, lighting candles.",
      "done": "Anselm says the crown calls to the old and the frightened, because we are easy to call? Ha. He is not wrong. Thank you, friend.",
      "turnIn": "corwin",
      "objectives": [{ "type": "talk", "target": "anselm", "count": 1, "label": "Speak to Brother Anselm" }],
      "rewards": { "xp": 30, "gold": 5, "items": [["potion", 1]] } },
    { "id": "hilde_kindling", "title": "Kindling for the Oven", "giver": "hilde",
      "summary": "Bring Hilde 8 Wood for her oven.",
      "offer": "My oven eats wood faster than I can buy it, and the woodcutters will not go into the trees after dark. Eight good pieces of wood and I will bake you something worth carrying.",
      "progress": "Chop any tree with the Use key. Three blows and it falls.",
      "done": "That will keep the oven roaring until the end of the week. Take your pick from the shelf.",
      "objectives": [{ "type": "collect", "item": "wood", "count": 8, "label": "Wood" }],
      "rewards": { "xp": 35, "gold": 8, "choice": [["roast", 4], ["bandage", 5]] } },
    { "id": "anselm_shrine", "title": "Light in the Dark", "giver": "anselm",
      "summary": "Awaken a wayside shrine.",
      "offer": "The wayside shrines were raised against the Hollow King when the realm was young. Each one that sleeps is a crack in the seal. Find one, lay your hand on it, and wake it. The Dawn will remember.",
      "progress": "The shrines are tall stone figures out in the wild. They glow faintly when they can be woken.",
      "done": "I felt it, I think. A little warmth, far away. Thank you, child. Take this blessing with you.",
      "objectives": [{ "type": "shrine", "count": 1, "label": "Wayside shrines awakened" }],
      "rewards": { "xp": 50, "gold": 10, "items": [["potion", 1]] } },
    { "id": "joss_hares", "title": "Hares in the Cabbages", "giver": "joss",
      "summary": "Hunt 6 hares in the fields around Greenhollow.",
      "offer": "Laugh if you like, but those hares will be the ruin of me. Six of them, at least, eating my winter cabbages. Hunt them down and I will see you right.",
      "progress": "They are quick. Get close and strike, or use a crossbow.",
      "done": "Six fewer mouths in my field! You have saved the winter, and my temper. Pick something; my wife made them.",
      "objectives": [{ "type": "kill", "target": "hare", "count": 6, "label": "Hares hunted" }],
      "rewards": { "xp": 40, "gold": 6, "choice": [["leather_boots", 1], ["leather_cap", 1]] } },
    { "id": "ottilie_hides", "title": "Thick Cloaks for Winter", "giver": "ottilie",
      "summary": "Bring Ottilie 3 Hides.",
      "offer": "Everybody wants a thick cloak this year, and I have no leather left. Bring me three hides from the beasts out in the vale and I will make it worth your while.",
      "progress": "Boars and deer give hides. Mind the tusks.",
      "done": "Fine hides. I will make a cloak for every child in the village. And this one is for you.",
      "objectives": [{ "type": "collect", "item": "hide", "count": 3, "label": "Hide" }],
      "rewards": { "xp": 45, "gold": 10, "choice": [["leather_armor", 1], ["leather_cap", 1]] } },
    { "id": "pip_message", "title": "A Message for the Huntress", "giver": "pip",
      "summary": "Tell Huntress Mira that Pip wants to be a hunter.",
      "offer": "Can you tell Mira something for me? Tell her I want to be a hunter like her when I grow up. But do not tell her I am scared of the dark. Just the hunter part.",
      "progress": "Mira is out in the square. She is the one with the bow.",
      "done": "She said yes? She said I can carry her arrows? You are the best!",
      "turnIn": "pip",
      "objectives": [{ "type": "talk", "target": "mira", "count": 1, "label": "Speak to Huntress Mira" }],
      "rewards": { "xp": 20, "items": [["arrows", 10]] } },
    { "id": "brenna_scouts", "title": "Bandit Scouts", "giver": "brenna", "requires": ["first_blade"],
      "summary": "Defeat 5 bandits on the roads near Greenhollow.",
      "offer": "Bandits have been scouting the village from the east road. Either they plan to rob us, or they are running from something and want our walls. Either way, I want them gone. Five should send the message.",
      "progress": "They camp along the road east, past the bridge. Some carry crossbows.",
      "done": "Five fewer bandits and one more reason for the rest to stay away. You fight like a Watch soldier. Take something from the rack.",
      "objectives": [{ "type": "kill", "target": "bandit", "count": 5, "label": "Bandits defeated" }],
      "rewards": { "xp": 70, "gold": 18, "choice": [["wood_shield", 1], ["leather_armor", 1], ["potion", 2]] } },
    { "id": "wendel_knees", "title": "An Old Man's Knees", "giver": "wendel",
      "summary": "Bring Gaffer Wendel 4 Herbs.",
      "offer": "My knees know when the cold is coming down from the peaks. They have known all year. Four herbs from the meadows and I can make a poultice. In exchange, I will tell you how the Hollow King came to be.",
      "progress": "Red flowers in the meadows. Pick them with the Use key.",
      "done": "Ahh, that is better already. Now, about the King... no, you have heard it. Take this instead, it was mine when I was young and foolish.",
      "objectives": [{ "type": "collect", "item": "herb", "count": 4, "label": "Herb" }],
      "rewards": { "xp": 35, "gold": 4, "items": [["band", 1]] } },

    { "id": "fenna_pelts", "title": "Wolf Pelts", "giver": "fenna",
      "summary": "Bring Innkeeper Fenna 4 Hides.",
      "offer": "The Rootbound is drafty and winter is close. I want wolf pelts on the walls and the floors. Four hides, and you will drink free for a month.",
      "progress": "Wolves roam deep in the forest. They hunt in pairs.",
      "done": "Lovely. The guests will be warm and the wolves will be fewer. Take this.",
      "objectives": [{ "type": "collect", "item": "hide", "count": 4, "label": "Hide" }],
      "rewards": { "xp": 70, "gold": 18, "choice": [["leather_armor", 1], ["leather_boots", 1]] } },
    { "id": "bram_grove", "title": "Stumplings in the Grove", "giver": "bram",
      "summary": "Fell 5 stumplings in Deepwood.",
      "offer": "My best grove is full of the walking stumps. They tore my saw from my hands. I want my grove back. Fell five of the things and we will call it even.",
      "progress": "They look like stumps until they move. Hit them hard; the bark is thick.",
      "done": "Five! Ha! You chop better than I do. Here, take something better than an axe.",
      "objectives": [{ "type": "kill", "target": "treant", "count": 5, "label": "Stumplings felled" }],
      "rewards": { "xp": 90, "gold": 22, "choice": [["iron_helm", 1], ["leather_boots", 1]] } },
    { "id": "maelis_shrines", "title": "The Broken Seal", "giver": "maelis",
      "summary": "Awaken 3 wayside shrines.",
      "offer": "My books say the seal on the Hollow King's crypt is held by the wayside shrines. If enough of them wake, the seal might hold a while longer. Wake three, and I will open the Archive's strongbox for you.",
      "progress": "The shrines are scattered over the realm. Pilgrim Oswin at Wayfarers' Rest knows the roads.",
      "done": "Three more lights in the dark. The seal holds, for now. The strongbox, as promised.",
      "objectives": [{ "type": "shrine", "count": 3, "label": "Wayside shrines awakened" }],
      "rewards": { "xp": 140, "gold": 30, "choice": [["potion", 3], ["band", 1], ["iron_helm", 1]], "rarity": 1 } },
    { "id": "gideon_wolves", "title": "White-Eyed Wolves", "giver": "gideon",
      "summary": "Hunt 6 wolves in Deepwood.",
      "offer": "The wolves are circling Thornwick, and their eyes have gone white. I cannot hunt them all alone. Six of them, and the circle breaks.",
      "progress": "They are bolder at night. So are you, hopefully.",
      "done": "The circle is broken. For now. Here, a hunter's thanks.",
      "objectives": [{ "type": "kill", "target": "wolf", "count": 6, "label": "Wolves hunted" }],
      "rewards": { "xp": 100, "gold": 20, "items": [["arrows", 20]], "choice": [["potion", 2], ["iron_helm", 1]] } },
    { "id": "odo_kiln", "title": "Feeding the Kiln", "giver": "odo",
      "summary": "Bring Odo 6 Wood and 4 Stone.",
      "offer": "My kiln must not go out. I need wood to burn and stone to patch the walls. Six wood and four stone and I will pay you in good coal.",
      "progress": "Trees for wood, grey rocks for stone. You know the drill.",
      "done": "The fire burns on. Here is your coal, the best in Deepwood.",
      "objectives": [{ "type": "collect", "item": "wood", "count": 6, "label": "Wood" }, { "type": "collect", "item": "stone", "count": 4, "label": "Stone" }],
      "rewards": { "xp": 60, "gold": 10, "items": [["coal", 4]] } },

    { "id": "dorian_bandits", "title": "Highway Robbery", "giver": "dorian",
      "summary": "Defeat 6 bandits in the Heartlands.",
      "offer": "Bandits robbed one of my wagons a mile from here, in daylight. I am a peaceful man, but I would pay well to see them taught a lesson. Six of them should do it.",
      "progress": "They prowl the roads all over the Heartlands.",
      "done": "Six! My wagons will roll again. You have earned this.",
      "objectives": [{ "type": "kill", "target": "bandit", "count": 6, "label": "Bandits defeated" }],
      "rewards": { "xp": 90, "gold": 25, "choice": [["iron_sword", 1], ["iron_shield", 1], ["leather_boots", 1]] } },
    { "id": "lysa_ballad", "title": "A Ballad Needs a Hero", "giver": "lysa",
      "summary": "Visit Saltmere and speak to Captain Brine for Lysa's ballad.",
      "offer": "My ballad needs a sea captain who has seen the dead ships. Captain Brine of Saltmere is the one. Would you ask him to tell you the story? I am too much of a coward to walk the coast road.",
      "progress": "Saltmere is south-east, on the coast. Captain Brine is in the square.",
      "done": "A ship with no crew, sails set, rudder tied? Oh, that is perfect. Terrible, but perfect. You shall be in the ballad too.",
      "turnIn": "lysa",
      "objectives": [{ "type": "talk", "target": "brine", "count": 1, "label": "Speak to Captain Brine" }],
      "rewards": { "xp": 80, "gold": 15, "items": [["potion", 1]] } },
    { "id": "vey_caravan", "title": "The Missing Caravan", "giver": "vey",
      "summary": "Ask Captain Brine in Saltmere whether the salt caravan left.",
      "offer": "My salt caravan is nine days late. Nine. If it never left Saltmere, I want to know. If it did... then I need to know that too. Ask Captain Brine.",
      "progress": "Saltmere is down the coast road, south-east of here.",
      "done": "It left on time? Then the coast road took it. Nine wagons and twelve good people. Thank you for finding out. Take this, it is the least I can do.",
      "turnIn": "vey",
      "objectives": [{ "type": "talk", "target": "brine", "count": 1, "label": "Speak to Captain Brine" }],
      "rewards": { "xp": 80, "gold": 30 } },
    { "id": "morwen_pilgrim", "title": "The Pilgrim's Path", "giver": "morwen",
      "summary": "Awaken 2 wayside shrines.",
      "offer": "The pilgrims used to walk from shrine to shrine and pray at each. Few walk now. Walk two of them for me. Wake the stones, and the Dawn will keep you.",
      "progress": "Pilgrim Oswin, out in the square, knows where they stand.",
      "done": "You walked the path. That is more than most. Take this blessing.",
      "objectives": [{ "type": "shrine", "count": 2, "label": "Wayside shrines awakened" }],
      "rewards": { "xp": 90, "gold": 12, "choice": [["potion", 2], ["band", 1]] } },
    { "id": "tull_venison", "title": "Venison for the Road", "giver": "tull",
      "summary": "Hunt 4 deer in the Heartlands.",
      "offer": "The deer run mad through the fields at night. Good meat, if somebody brave hunts them. Four of them, and I will smoke the meat for the travellers who still pass through.",
      "progress": "They flee from you. A crossbow helps.",
      "done": "Fine animals. The travellers will eat well. Take your share.",
      "objectives": [{ "type": "kill", "target": "deer", "count": 4, "label": "Deer hunted" }],
      "rewards": { "xp": 60, "gold": 12, "items": [["roast", 3]] } },
    { "id": "agna_stone", "title": "Stone for the Wall", "giver": "agna",
      "summary": "Bring Agna 10 Stone.",
      "offer": "Highwatch wants their wall raised and I need stone, lots of it. Bring me ten good pieces and I will pay in coin and craft.",
      "progress": "Mine the grey mossy rocks. They are everywhere.",
      "done": "Good solid stone. Highwatch will stand a little taller. Your pay.",
      "objectives": [{ "type": "collect", "item": "stone", "count": 10, "label": "Stone" }],
      "rewards": { "xp": 70, "gold": 20, "choice": [["iron_helm", 1], ["pickaxe", 1]] } },

    { "id": "maeve_smugglers", "title": "Unwelcome Guests", "giver": "maeve",
      "summary": "Defeat 5 smugglers on the coast.",
      "offer": "Some of the smugglers who drink here have turned nasty. They rough up my girls and do not pay. I want them gone. Five of them, out on the coast, and the rest will learn manners.",
      "progress": "They camp on the dunes south and east of town.",
      "done": "That will teach them. Your drinks are free, and so is this.",
      "objectives": [{ "type": "kill", "target": "smuggler", "count": 5, "label": "Smugglers defeated" }],
      "rewards": { "xp": 130, "gold": 30, "choice": [["iron_greaves", 1], ["potion", 2]] } },
    { "id": "oskar_grouse", "title": "Vicious Birds", "giver": "oskar",
      "summary": "Hunt 5 black grouse on the dunes.",
      "offer": "The grouse on the dunes have gone vicious. They went for my eyes when I was mending nets! Five of them, and we can eat them too.",
      "progress": "They fly low over the dunes. A crossbow is best.",
      "done": "Ha! Grouse pie tonight. Take a share of the catch.",
      "objectives": [{ "type": "kill", "target": "grouse", "count": 5, "label": "Grouse hunted" }],
      "rewards": { "xp": 90, "gold": 14, "items": [["roast", 4]] } },
    { "id": "ilse_iron", "title": "The Harbour Chains", "giver": "ilse",
      "summary": "Bring Harbourmaster Ilse 5 Iron Ore.",
      "offer": "The great chains that close the harbour mouth are rusted through. Without them, the smugglers come and go as they please. Bring me five iron ore and Dagna can forge new links.",
      "progress": "Rusty crystal rocks hold iron. You need a pickaxe.",
      "done": "Iron! The chains will be mended by the next tide. The harbour thanks you.",
      "objectives": [{ "type": "collect", "item": "iron", "count": 5, "label": "Iron Ore" }],
      "rewards": { "xp": 120, "gold": 35, "choice": [["iron_greaves", 1], ["iron_helm", 1], ["iron_shield", 1]] } },
    { "id": "corin_drowned", "title": "Rest for the Drowned", "giver": "corin",
      "summary": "Lay 6 drowned dead to rest in the Drowned Vaults.",
      "offer": "The sea has given its dead back to the Hollow King. They walk the vaults to the east, in the marsh. Every one you lay to rest is a soul returned to the tides. Six would be a mercy.",
      "progress": "The Drowned Vaults lie east of Fenwatch, in the Ashen Marsh.",
      "done": "The tides are quieter tonight. I can feel it. Take this, and the sea's blessing.",
      "objectives": [{ "type": "kill", "target": "drowned", "count": 6, "label": "Drowned laid to rest" }],
      "rewards": { "xp": 220, "gold": 40, "choice": [["chain_armor", 1], ["potion", 3]], "rarity": 1 } },
    { "id": "agathe_henrick", "title": "News of Henrick", "giver": "agathe",
      "summary": "Ask Captain Brine what became of Henrick.",
      "offer": "My Henrick sailed in the Captain's convoy last winter. Everyone says he went over the side, but nobody saw it. Please, ask the Captain. I cannot bear to.",
      "progress": "Captain Brine is in the square.",
      "done": "He fought? He fought them off the deck so the others could escape? Then he did not just... thank you. Thank you. Take this. It was his.",
      "turnIn": "agathe",
      "objectives": [{ "type": "talk", "target": "brine", "count": 1, "label": "Speak to Captain Brine" }],
      "rewards": { "xp": 70, "items": [["signet", 1]] } },

    { "id": "hale_stalkers", "title": "Hunters in the Reeds", "giver": "hale",
      "summary": "Kill 6 stalkers in the Ashen Marsh.",
      "offer": "The stalkers have taken five of my men. Pale, quiet things, they wait in the reeds. I want them dead. Six, and the patrols can walk the marsh again.",
      "progress": "They hide in the reeds and charge when you are close. Keep moving.",
      "done": "Six. My men will sleep tonight. Take what you need from the armoury.",
      "objectives": [{ "type": "kill", "target": "stalker", "count": 6, "label": "Stalkers killed" }],
      "rewards": { "xp": 220, "gold": 45, "choice": [["chain_armor", 1], ["iron_greaves", 1], ["potion", 3]] } },
    { "id": "rook_bark", "title": "Slow-Burning Bark", "giver": "rook",
      "summary": "Bring Rook 3 Living Bark.",
      "offer": "The walking trees in the marsh shed a bark that burns warm all night. If the lantern goes out, we leave. Bring me three pieces and the lantern stays lit.",
      "progress": "Mire treants walk the marsh. Their bark is the prize.",
      "done": "The lantern will burn till spring. Thank you, friend.",
      "objectives": [{ "type": "collect", "item": "bark", "count": 3, "label": "Living Bark" }],
      "rewards": { "xp": 160, "gold": 30, "items": [["potion", 2]] } },
    { "id": "bryn_herbs", "title": "Fever Herbs", "giver": "bryn",
      "summary": "Bring Mother Bryn 8 Herbs.",
      "offer": "Marsh fever is in the barracks. I can brew a cure, but I need herbs, and lots of them. Eight, if you please.",
      "progress": "Herbs grow even here, in the drier patches.",
      "done": "That will do it. The soldiers will be on their feet in a week. Take some of my best.",
      "objectives": [{ "type": "collect", "item": "herb", "count": 8, "label": "Herb" }],
      "rewards": { "xp": 140, "gold": 15, "choice": [["potion", 3], ["bandage", 8]] } },
    { "id": "ash_crows", "title": "Carrion Crows", "giver": "ash",
      "summary": "Shoot down 5 carrion crows in the marsh.",
      "offer": "The crows follow the dead and watch our camps. I swear they report back to something. Bring down five of them.",
      "progress": "They fly over the marsh. Crossbow, if you have one.",
      "done": "Five fewer eyes in the sky. Here, more bolts for the next five.",
      "objectives": [{ "type": "kill", "target": "crow", "count": 5, "label": "Crows shot down" }],
      "rewards": { "xp": 160, "gold": 25, "items": [["arrows", 30]] } },

    { "id": "torvald_patrols", "title": "Thin the Hollow Ranks", "giver": "torvald",
      "summary": "Destroy 8 hollow knights.",
      "offer": "Hollow knights patrol the ridges between here and the crypt. They do not stop when you cut them, but they do stop when you break them. Break eight, and my sentries get a night's sleep.",
      "progress": "The hollow knights guard the Hollow Crypt and the ridges around it.",
      "done": "Eight! The Commander will hear of this. Take your pick of the armoury's best.",
      "objectives": [{ "type": "kill", "target": "hollow", "count": 8, "label": "Hollow knights destroyed" }],
      "rewards": { "xp": 380, "gold": 70, "choice": [["champion_shield", 1], ["great_helm", 1], ["frost_treads", 1]], "rarity": 1 } },
    { "id": "sigrun_shards", "title": "A Brother Lost", "giver": "sigrun",
      "summary": "Bring Sigrun 3 Frost Shards from the peaks.",
      "offer": "My brother went to dig frost shards and never came back. I cannot go after him. But I can finish his work. Bring me three shards, and I will sell them to Bjarn in his name.",
      "progress": "Frost shards drop from ice hawks, and lie in the Frostpeak Mine.",
      "done": "He would have been proud. Thank you. Take this, I cannot use it.",
      "objectives": [{ "type": "collect", "item": "frost_shard", "count": 3, "label": "Frost Shard" }],
      "rewards": { "xp": 240, "gold": 50, "choice": [["frost_treads", 1], ["potion", 3]] } },
    { "id": "elowen_seal", "title": "The Last Light", "giver": "elowen",
      "summary": "Awaken 5 wayside shrines across the realm.",
      "offer": "The seal is failing. Every dark shrine is a crack in the Hollow King's prison. Wake five, anywhere in the realm, and the Chapel will give you something the Watch has kept for three hundred years.",
      "progress": "The shrines are scattered over every region. Look for the tall stone figures.",
      "done": "Five! The light holds. Take this. It is a shard of the crystal the first knights carried.",
      "objectives": [{ "type": "shrine", "count": 5, "label": "Wayside shrines awakened" }],
      "rewards": { "xp": 300, "gold": 40, "items": [["heart_shard", 1]] } },
    { "id": "gunnar_miners", "title": "Put Them to Rest", "giver": "gunnar",
      "summary": "Put 6 frozen miners to rest in the Frostpeak Mine.",
      "offer": "My lads are down there still. Pale, cold, hungry. They are not my friends any more. Six of them, please. Let them rest.",
      "progress": "The Frostpeak Mine is west along the mountain road.",
      "done": "Thank you. I will carve their names on the mine gate. Take my old pick-coin, I will not need it.",
      "objectives": [{ "type": "kill", "target": "frozen", "count": 6, "label": "Frozen miners laid to rest" }],
      "rewards": { "xp": 300, "gold": 60, "items": [["coal", 6]] } },
    { "id": "aldous_hawks", "title": "Messengers of the Dead", "giver": "aldous",
      "summary": "Shoot down 5 ice hawks.",
      "offer": "Ice hawks circle the crypt. The old soldiers say they carry messages for the dead. Superstition, surely. But bring down five, and we will see whether the patrols get any quieter.",
      "progress": "They fly over the frozen peaks.",
      "done": "Quieter, yes. Interesting. Very interesting. Here, for the Archive's thanks.",
      "objectives": [{ "type": "kill", "target": "hawk", "count": 5, "label": "Ice hawks shot down" }],
      "rewards": { "xp": 260, "gold": 40, "choice": [["signet", 1], ["potion", 3]] } },
    { "id": "kari_wolves", "title": "Frost in the Fur", "giver": "kari",
      "summary": "Hunt 6 wolves in the frozen peaks.",
      "offer": "Frost wolves are hunting my traplines empty. If I cannot trap, the garrison starves. Six of the beasts and the packs will move on.",
      "progress": "They hunt in packs. Do not let them circle you.",
      "done": "That will do. The traps will fill again. Here, the warmest boots in Highwatch.",
      "objectives": [{ "type": "kill", "target": "wolf", "count": 6, "label": "Wolves hunted" }],
      "rewards": { "xp": 280, "gold": 40, "choice": [["frost_treads", 1], ["roast", 6]] } },
    { "id": "hedda_coal", "title": "Warm Hearths", "giver": "hedda",
      "summary": "Bring Old Hedda 6 Coal.",
      "offer": "The cold up here kills more people than the dead. Six coal, and the old folk of Highwatch will see another spring.",
      "progress": "Black smouldering rocks hold coal. You need a pickaxe.",
      "done": "Bless you, child. Warm hearths, warm hearts. Take this, and keep warm yourself.",
      "objectives": [{ "type": "collect", "item": "coal", "count": 6, "label": "Coal" }],
      "rewards": { "xp": 220, "gold": 30, "items": [["roast", 4]] } }
  ]
}
