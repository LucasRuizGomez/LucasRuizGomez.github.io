  // Random bonuses. "slots" says which gear types can roll it.
  "affixes": [
    { "id": "might",     "label": "of Might",     "stat": "dmg",   "min": 1, "max": 3,  "slots": ["weapon", "trinket"],          "text": "+{v} damage" },
    { "id": "vitality",  "label": "of Vitality",  "stat": "hp",    "min": 1, "max": 1,  "slots": ["armor", "trinket"],   "text": "+{h} hearts" },
    { "id": "haste",     "label": "of Haste",     "stat": "speed", "min": 4, "max": 10, "slots": ["boots", "trinket", "weapon"], "text": "+{v}% movement speed" },
    { "id": "precision", "label": "of Precision", "stat": "crit",  "min": 6, "max": 15, "slots": ["weapon", "trinket"],          "text": "{v}% chance to strike twice as hard" },
