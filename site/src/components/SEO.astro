---
// All <head> meta. Pages pass title and description (plus image when they have one) to Base.astro.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { links, seo, site } from '../config';

interface Props {
  title?: string; // site name only when omitted
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
}
const { title, description = site.description, image = site.defaultOgImage, noindex = false } =
  Astro.props;

// Scrapers that read og:image want a JPEG at the standard size, so it is baked here.
const cardSize = { width: 1200, height: 630 };
const card = await getImage({ src: image, format: 'jpeg', ...cardSize, fit: 'cover' });

const fullTitle = title ? seo.titleTemplate.replace('%s', title) : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(card.src, Astro.site);
const home = new URL('/', Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.author,
    url: home,
    jobTitle: 'Student, Computer Science and Business Administration',
    affiliation: { '@type': 'CollegeOrUniversity', name: 'Universidad Carlos III de Madrid' },
    address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
    sameAs: [links.github, links.linkedin],
  },
];
// prevent </script> injection
const schemaJson = JSON.stringify(schema).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(cardSize.width)} />
<meta property="og:image:height" content={String(cardSize.height)} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script is:inline type="application/ld+json" set:html={schemaJson}></script>
