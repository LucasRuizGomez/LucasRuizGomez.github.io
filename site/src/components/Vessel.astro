---
// The feeder ship LUKEDA, seen from starboard, carrying the projects as 40ft containers.
// Hull, superstructure and funnel are one SVG; the containers are buttons laid over its deck in
// the same coordinate space (a 1000 x 560 box), so they scale and roll with the ship.
// A ship-to-shore crane's spreader hangs over the stack and follows the pointer from bay to bay.
// Click a container: the spreader drops onto it, locks, and hoists it clear of the ship; its side
// panel swings open, the hold lights up, and the manifest card for what is inside opens as a
// dialog. Closing the card sets the box back down. Reduced motion skips the crane work.
import { Image } from 'astro:assets';
import type { Project } from '../data/profile';
import LinkRow from './LinkRow.astro';

interface Props {
  projects: Project[];
  name: string;
  port: string;
  class?: string;
}
const { projects, name, port, class: className } = Astro.props;

// ISO 6346 owner code + category, six-digit serial, check digit (A=10, skipping 11, 22, 33).
const OWNER = 'LRGU';
const letterValue = (ch: string) => {
  let v = 10;
  for (let c = 65; c < ch.charCodeAt(0); c++) {
    v++;
    if (v % 11 === 0) v++;
  }
  return v;
};
const checkDigit = (code: string) =>
  ([...code].reduce((s, ch, i) => s + (/\d/.test(ch) ? +ch : letterValue(ch)) * 2 ** i, 0) % 11) % 10;

// Stowage: three bays of 40ft, three tiers high. Bay x and tier y are in SVG units.
const BAYS = [248, 458, 668];
const BAY_W = 202;
const TIER_H = 70;
const DECK = 372;
const W = 1000;
const H = 560;
const tones = ['red', 'ink', 'bone', 'steel', 'deep', 'red', 'bone', 'ink', 'steel'];
const slots = [2, 1, 0].flatMap((tier) => BAYS.map((x) => ({ x, y: DECK - TIER_H * (tier + 1) })));
const pos = (s: { x: number; y: number }) =>
  `left:${(s.x / W) * 100}%;top:${(s.y / H) * 100}%;width:${(BAY_W / W) * 100}%;height:${(TIER_H / H) * 100}%`;

const boxes = slots.map((slot, i) => {
  const p = projects[i];
  const serial = String(i + 1).padStart(6, '0');
  return { slot, tone: tones[i], p, n: i, code: `${OWNER} ${serial}`, check: checkDigit(OWNER + serial), id: `cargo-${i + 1}` };
});

// Accommodation windows: a grid, a few lit.
const windowRows = [170, 200, 230, 260, 290, 320, 350];
const windowCols = Array.from({ length: 6 }, (_, i) => 86 + i * 22);
const lit = (r: number, c: number) => (r * 7 + c * 3) % 5 === 0;

// The crane starts out over the middle bay of the top tier.
const craneHome = `left:${(slots[1].x / W) * 100}%;width:${(BAY_W / W) * 100}%`;
---

<div class:list={['vessel-wrap', className]}>
  <p class="hint"><span class="hint-lamp" aria-hidden="true"></span>Each container is a project · pick one to unload it</p>
  <div class="vessel-pos">
    <div class="vessel">
      <svg class="hull-art" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
        <defs>
          <clipPath id="hull-clip">
            <path id="hull-shape" d="M15 385 L905 385 L986 366 C979 408 969 440 963 460 C986 468 996 494 977 511 C966 521 946 524 930 524 L122 524 C76 524 46 506 33 479 Z" />
          </clipPath>
        </defs>

        {/* Funnel, behind the accommodation */}
        <path class="funnel" d="M26 385 L32 176 L74 172 L70 385 Z" />
        <path class="funnel-band" d="M31.3 196 L73.4 193 L73 212 L30.8 215 Z" />
        <path class="funnel-top" d="M32 176 L74 172 L73.7 182 L31.7 186 Z" />

        {/* Accommodation block and bridge */}
        <rect class="super" x="76" y="150" width="148" height="235" />
        <rect class="super-shade" x="76" y="150" width="10" height="235" />
        {windowRows.map((y, r) =>
          windowCols.map((x, c) => (
            <rect class:list={['win', lit(r, c) && 'win-lit']} x={x} y={y} width="12" height="9" />
          )),
        )}
        <rect class="super" x="56" y="112" width="186" height="38" />
        <rect class="win" x="62" y="120" width="174" height="15" />
        {Array.from({ length: 11 }, (_, i) => (
          <rect class="super" x={62 + 14 + i * 15} y="120" width="2" height="15" />
        ))}
        <rect class="super-shade" x="56" y="146" width="186" height="4" />
        <circle class="nav-green" cx="240" cy="128" r="3.2" />

        {/* Mast with radar */}
        <rect class="mast" x="147" y="50" width="5" height="62" />
        <rect class="mast" x="122" y="72" width="54" height="5" />
        <rect class="radar" x="128" y="60" width="42" height="5" />
        <circle class="mast-light" cx="149.5" cy="47" r="3.5" />

        {/* Hull: steel above, boot-top at the waterline, antifouling red below */}
        <use href="#hull-shape" class="hull" />
        <g clip-path="url(#hull-clip)">
          <rect class="boot" x="0" y="446" width={W} height="10" />
          <rect class="bottom" x="0" y="456" width={W} height="120" />
          <rect class="hull-shadow" x="0" y="385" width={W} height="14" />
        </g>
        <path class="sheer" d="M18 391 L904 391 L982 373" />

        {/* Hatch covers and lashing bridges under and between the bays */}
        <rect class="hatch" x="242" y="372" width="634" height="13" />
        <rect class="lash" x="451" y="232" width="6" height="140" />
        <rect class="lash" x="661" y="232" width="6" height="140" />

        {/* Forecastle: rail, foremast, anchor */}
        <path class="rail" d="M884 370 L982 352 M890 369 L890 359 M910 365 L910 355 M930 362 L930 352 M950 358 L950 348 M970 355 L970 345" />
        <rect class="mast" x="952" y="292" width="4" height="66" />
        <circle class="mast-light" cx="954" cy="289" r="3" />
        <circle class="hawse" cx="938" cy="402" r="5" />
        <path class="anchor" d="M938 407 L938 428 M930 418 Q938 432 946 418 M933 411 L943 411" />

        {/* Name on the bow, port of registry on the quarter, draught marks */}
        <text class="ship-name" x="912" y="430" text-anchor="end">{name}</text>
        <text class="ship-port" x="44" y="428">{name} · {port}</text>
        <g class="draught">
          <text x="968" y="448">8M</text>
          <text x="961" y="437">— </text>
        </g>
      </svg>

      <span class="puff p1" aria-hidden="true"></span>
      <span class="puff p2" aria-hidden="true"></span>
      <span class="puff p3" aria-hidden="true"></span>

      {boxes.map((b) =>
        b.p ? (
          <button
            type="button"
            class="box"
            data-tone={b.tone}
            data-box={b.id}
            data-top={b.slot.y}
            style={`${pos(b.slot)};--i:${b.n}`}
            aria-haspopup="dialog"
            aria-label={`Open ${b.p.name}`}
          >
            <span class="box-hold" aria-hidden="true">
              <span class="box-crate"></span>
            </span>
            <span class="box-face" aria-hidden="true">
              <span class="box-code">
                {b.code} <b>{b.check}</b>
              </span>
              <span class="box-name">{b.p.name}</span>
              <span class="box-logo">L</span>
              <span class="box-type">45G1</span>
            </span>
          </button>
        ) : (
          <span class="box box-filler" data-tone={b.tone} style={pos(b.slot)} aria-hidden="true">
            <span class="box-face">
              <span class="box-code">
                {b.code} <b>{b.check}</b>
              </span>
              <span class="box-logo">L</span>
            </span>
          </span>
        ),
      )}

      {/* The crane: its boom runs out toward the viewer above the picture, so only the falls and
          the spreader show. */}
      <div class="crane" aria-hidden="true" style={craneHome}>
        <div class="crane-hoist">
          <div class="crane-bob">
            <span class="crane-falls"></span>
            <svg class="crane-spreader" viewBox="0 0 202 26">
              <path class="sp-head" d="M84 0 H118 L122 10 H80 Z" />
              <circle class="sp-sheave" cx="101" cy="5" r="2.6" />
              <path class="sp-strut" d="M84 10 L40 13 M118 10 L162 13" />
              <rect class="sp-beam" x="0" y="12" width="202" height="10" />
              <rect class="sp-beam-shade" x="0" y="19" width="202" height="3" />
              <rect class="sp-end" x="0" y="10" width="11" height="12" />
              <rect class="sp-end" x="191" y="10" width="11" height="12" />
              <rect class="sp-pin" x="3" y="22" width="5" height="4" />
              <rect class="sp-pin" x="194" y="22" width="5" height="4" />
              <circle class="sp-lamp" cx="22" cy="16.5" r="2.4" />
              <circle class="sp-lamp" cx="180" cy="16.5" r="2.4" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{boxes.filter((b) => b.p).map((b) => (
  <dialog id={b.id} class="cargo" data-tone={b.tone} aria-labelledby={`${b.id}-title`}>
    <div class="cargo-inner">
      <div class="cargo-head font-mono">
        <span>
          {b.code} <b>{b.check}</b> · 45G1 · {name}
        </span>
        <form method="dialog">
          <button class="cargo-close" type="submit">Close ✕</button>
        </form>
      </div>
      <div class="cargo-body">
      <Image
        class="cargo-shot"
        src={b.p.image}
        alt={b.p.imageAlt}
        widths={[480, 720, 960]}
        sizes="(min-width: 768px) 32rem, 92vw"
        format="avif"
        loading="lazy"
      />
      <div class="p-5 sm:p-7">
        <span class="kicker">Contents</span>
        <h2
          id={`${b.id}-title`}
          class="font-ui mt-3 text-[clamp(1.75rem,4vw,2.5rem)] leading-[0.95] font-extrabold tracking-[-0.025em] uppercase"
        >
          {b.p.name}
        </h2>
        <p class="mt-3 text-[1.125rem] leading-snug">{b.p.summary}</p>
        <p class="mt-3 text-[0.9375rem] leading-relaxed">{b.p.detail}</p>
        <p class="text-muted mt-4 font-mono text-[0.6875rem] uppercase">{b.p.stack.join(' · ')}</p>
        <LinkRow class="mt-5" links={b.p.links} name={b.p.name} />
      </div>
      </div>
    </div>
  </dialog>
))}

<script>
  // Spreader geometry in drawing units (the ship is drawn in a 1000 x 560 box).
  const SPREADER_H = 26; // headblock to the tips of the twistlocks
  const SEAT = 22; // spreader top above the container roof with the twistlocks home
  const CRANE_TOP = -20; // where the falls leave the picture
  const IDLE = 80; // spreader top while it waits over the stack
  const LIFTED = 34; // container roof once it is hoisted clear
  const BOX_H = 70;

  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const crane = document.querySelector<HTMLElement>('.crane');
  const hoist = crane?.querySelector<HTMLElement>('.crane-hoist') ?? null;
  // Percentages of the element's own height, so a resize mid-lift keeps everything lined up.
  const at = (y: number) => `translateY(${((y - CRANE_TOP) / SPREADER_H) * 100}%)`;
  const wait = (ms: number) => new Promise((r) => window.setTimeout(r, ms));

  let hoistY = IDLE;
  if (hoist) hoist.style.transform = at(IDLE);

  // Run one move and leave the element where it stopped, without piling up finished animations.
  const move = async (el: HTMLElement, to: string, ms: number) => {
    const a = el.animate([{ transform: getComputedStyle(el).transform }, { transform: to }], {
      duration: ms,
      easing: 'cubic-bezier(0.45, 0, 0.25, 1)',
      fill: 'forwards',
    });
    await a.finished;
    a.commitStyles();
    a.cancel();
  };
  const raise = (y: number, ms: number) => {
    const from = hoistY;
    hoistY = y;
    return hoist && from !== y ? move(hoist, at(y), ms) : Promise.resolve();
  };

  let queue: Promise<void> = Promise.resolve();
  let working = false; // the crane is busy with a box
  let claimed = false; // a box has been picked and its card has not been closed yet
  let arrives = 0; // when the trolley finishes its current run

  // Trolley out over a bay; resolves once it is there, even if a hover sent it on its way.
  const aim = async (btn: HTMLButtonElement) => {
    if (!crane) return;
    if (crane.style.left !== btn.style.left) {
      crane.style.left = btn.style.left;
      arrives = performance.now() + 480;
    }
    if (!reduce()) await wait(Math.max(0, arrives - performance.now()));
  };

  const unload = async (btn: HTMLButtonElement, dialog: HTMLDialogElement) => {
    working = true;
    crane?.classList.add('is-busy');
    if (reduce() || !crane || !hoist) {
      btn.classList.add('is-open');
      dialog.showModal();
      return;
    }
    const roof = Number(btn.dataset.top);
    await aim(btn);
    await raise(roof - SEAT, 160 + Math.abs(roof - SEAT - hoistY) * 2.6);
    crane.classList.add('is-locked');
    await wait(240);
    btn.classList.add('is-hoisted');
    await Promise.all([
      raise(LIFTED - SEAT, 780),
      move(btn, `translateY(${((LIFTED - roof) / BOX_H) * 100}%)`, 780),
    ]);
    // Swing the panel open while it hangs, then bring the card out of the hold.
    btn.classList.add('is-open');
    await wait(380);
    dialog.showModal();
  };

  const setDown = async (btn: HTMLButtonElement) => {
    btn.classList.remove('is-open');
    if (reduce() || !crane || !hoist) {
      btn.classList.remove('is-hoisted');
      crane?.classList.remove('is-busy', 'is-locked');
      working = false;
      return;
    }
    const roof = Number(btn.dataset.top);
    await wait(420); // the panel shuts first
    await Promise.all([raise(roof - SEAT, 700), move(btn, 'translateY(0%)', 700)]);
    btn.style.transform = '';
    btn.classList.remove('is-hoisted');
    crane.classList.remove('is-locked');
    await wait(180);
    await raise(IDLE, 140 + Math.abs(IDLE - hoistY) * 2.6);
    crane.classList.remove('is-busy');
    working = false;
  };

  document.querySelectorAll<HTMLButtonElement>('button[data-box]').forEach((btn) => {
    const dialog = document.getElementById(btn.dataset.box!) as HTMLDialogElement | null;
    if (!dialog) return;
    // The trolley follows the pointer (or keyboard focus) from bay to bay.
    const follow = () => {
      if (!working && !claimed) aim(btn);
    };
    btn.addEventListener('pointerenter', follow);
    btn.addEventListener('focus', follow);
    btn.addEventListener('click', () => {
      if (claimed) return;
      claimed = true;
      // Picked while another box is still being set down: it waits its turn.
      queue = queue.then(() => unload(btn, dialog)).catch(console.error);
    });
    dialog.addEventListener('close', () => {
      claimed = false;
      queue = queue.then(() => setDown(btn)).catch(console.error);
    });
    // A click on the backdrop closes it; the card itself fills the dialog box.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .vessel-wrap {
    /* The ship is printed in fixed plate colours: it always sits on the dark cover plate. */
    --hull: #3d4249;
    --hull-shadow: #2a2e33;
    --antifoul: #b3262f;
    --boot: #121315;
    --super: #dcdcd6;
    --super-shade: #b9b9b2;
    --window: #1b1d21;
    --window-lit: #f1c36a;
    --steel-line: #e9e9e4;
    --funnel: #24272b;
    --spot: var(--primary-on-plate);
  }

  /* Lined up over the first bay, so it stays on screen when a phone crops the ship. */
  .hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: 24.8%;
    margin-block-end: 0.75rem;
    color: var(--on-plate);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  /* A slow status lamp in the funnel-band red. */
  .hint-lamp {
    flex: none;
    inline-size: 0.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--spot);
    animation: lamp 2.4s ease-out infinite;
  }
  @keyframes lamp {
    0% { box-shadow: 0 0 0 0 rgb(244 69 79 / 0.55); }
    70%, 100% { box-shadow: 0 0 0 0.45rem rgb(244 69 79 / 0); }
  }

  /* The waterline sits at 81.4% of the drawing; this pulls the box's bottom edge up to it so the
     sea underneath can take the hull to the line. */
  .vessel-pos {
    /* 18.6% of the drawing's height, as a share of its width (560 / 1000). */
    margin-block-end: -10.4%;
  }
  .vessel {
    position: relative;
    aspect-ratio: 1000 / 560;
    transform-origin: 50% 85%;
    animation: roll 7s ease-in-out infinite;
  }
  @keyframes roll {
    0%, 100% { transform: translateY(0) rotate(-0.35deg); }
    50% { transform: translateY(1.2%) rotate(0.35deg); }
  }
  .hull-art {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }
  .hull { fill: var(--hull); }
  .hull-shadow { fill: var(--hull-shadow); opacity: 0.8; }
  .boot { fill: var(--boot); }
  .bottom { fill: var(--antifoul); }
  .sheer { fill: none; stroke: var(--steel-line); stroke-width: 2.5; opacity: 0.75; }
  .super { fill: var(--super); }
  .super-shade { fill: var(--super-shade); }
  .win { fill: var(--window); }
  .win-lit { fill: var(--window-lit); }
  .funnel { fill: var(--funnel); }
  .funnel-band { fill: var(--spot); }
  .funnel-top { fill: #0d0e10; }
  .mast { fill: var(--super-shade); }
  .radar { fill: var(--super); animation: sweep 3.2s linear infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes sweep {
    0% { transform: scaleX(1); }
    50% { transform: scaleX(0.15); }
    100% { transform: scaleX(1); }
  }
  .mast-light { fill: #fff6d8; animation: blink 2.4s steps(1) infinite; }
  @keyframes blink {
    0%, 70% { opacity: 1; }
    71%, 100% { opacity: 0.25; }
  }
  .nav-green { fill: #3ddc84; }
  .hatch { fill: #2b2f34; }
  .lash { fill: #9a9ea3; opacity: 0.8; }
  .rail { fill: none; stroke: var(--steel-line); stroke-width: 2; opacity: 0.7; }
  .hawse { fill: #15171a; }
  .anchor { fill: none; stroke: #15171a; stroke-width: 3; stroke-linecap: round; }
  .ship-name {
    fill: var(--steel-line);
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 22px;
    letter-spacing: 4px;
  }
  .ship-port {
    fill: var(--steel-line);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 2px;
    opacity: 0.85;
  }
  .draught text {
    fill: var(--steel-line);
    font-family: var(--font-mono);
    font-size: 9px;
    opacity: 0.8;
  }

  /* Smoke off the funnel, drifting aft. */
  .puff {
    position: absolute;
    left: 3.6%;
    top: 24.5%;
    inline-size: 4.4%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(201 201 198 / 0.45), rgb(201 201 198 / 0) 70%);
    opacity: 0;
    animation: smoke 6s linear infinite;
  }
  .p2 { animation-delay: 2s; }
  .p3 { animation-delay: 4s; }
  @keyframes smoke {
    0% { transform: translate(0, 0) scale(0.5); opacity: 0; }
    15% { opacity: 0.55; }
    100% { transform: translate(-160%, -260%) scale(2.2); opacity: 0; }
  }

  /* ── Containers: 40ft, seen from the side ── */
  .box {
    --c: #d23a43;
    --rib: #a92b33;
    --ink: #ffffff;
    --post: #7e1f26;
    position: absolute;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    container-type: inline-size;
    perspective: 700px;
    cursor: pointer;
    /* `translate` is the hover nudge and the hello hop; `transform` belongs to the crane. */
    transition: translate 260ms cubic-bezier(0.2, 0.7, 0.2, 1), filter 260ms;
  }
  /* Once, shortly after the page settles, the project boxes hop in turn: these ones move. */
  button.box {
    animation: hello 700ms cubic-bezier(0.3, 0.7, 0.3, 1) calc(1.4s + var(--i, 0) * 110ms) 1 backwards;
  }
  @keyframes hello {
    0%, 100% { translate: 0 0; }
    35% { translate: 0 -14%; }
    60% { translate: 0 0; }
    75% { translate: 0 -4%; }
  }
  .box[data-tone='ink'] { --c: #33363b; --rib: #25272b; --ink: #ececea; --post: #1b1c1f; }
  .box[data-tone='bone'] { --c: #cfcfc8; --rib: #aeaea7; --ink: #141416; --post: #8f8f88; }
  .box[data-tone='steel'] { --c: #66707a; --rib: #505961; --ink: #ffffff; --post: #3d444b; }
  .box[data-tone='deep'] { --c: #8e1c26; --rib: #6e141c; --ink: #ffffff; --post: #520e14; }
  .box-filler { cursor: default; }

  /* Hover: the box rises a touch on its lashings and catches the light. */
  button.box:hover,
  button.box:focus-visible {
    translate: 0 -6%;
    filter: brightness(1.12);
    z-index: 2;
  }
  button.box.is-hoisted {
    translate: 0 0;
    filter: none;
    z-index: 3;
  }
  button.box:focus-visible {
    outline: 2px solid var(--on-plate);
    outline-offset: 3px;
  }

  .box-face,
  .box-hold {
    position: absolute;
    inset: 0;
  }
  .box-face {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr auto;
    padding: 3.5% 6% 4%;
    color: var(--ink);
    text-align: start;
    background:
      /* corner castings */
      linear-gradient(#111, #111) left top / 3.2% 12% no-repeat,
      linear-gradient(#111, #111) right top / 3.2% 12% no-repeat,
      linear-gradient(#111, #111) left bottom / 3.2% 12% no-repeat,
      linear-gradient(#111, #111) right bottom / 3.2% 12% no-repeat,
      /* top and bottom rails */
      linear-gradient(to bottom, rgb(0 0 0 / 0.32) 0 7%, transparent 7% 90%, rgb(0 0 0 / 0.42) 90%),
      /* corner posts */
