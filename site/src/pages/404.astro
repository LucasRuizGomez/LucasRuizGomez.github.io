---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <div class="max-w-content mx-auto px-4 py-24">
    <span class="kicker">404</span>
    <h1 class="font-ui mt-3 text-[clamp(2.25rem,6vw,4rem)] leading-[0.9] font-extrabold tracking-[-0.035em] uppercase">
      Page not found
    </h1>
    <p class="mt-5 text-lg">The page you asked for is not here.</p>
    <p class="font-ui mt-6 text-sm font-bold uppercase">
      <a class="hover:text-primary border-b-2 border-current py-1 no-underline" href="/">Back to the home page →</a>
    </p>
  </div>
</Base>
